WALLET_KEY=0xYOUR_PRIVATE_KEY

# PRIMARY RPC — prefer a PRIVATE / premium endpoint (Blast, QuikNode, chain-native, self-hosted).
# Public Alchemy/Infura free tiers are fallback only; they dominate inclusion latency (~200-300ms).
RPC_URL=https://YOUR-PRIVATE-OR-PREMIUM-RPC

# Extra RPCs for parallel eth_sendRawTransaction fan-out (comma-separated). Fastest private first.
# Example: BROADCAST_RPCS=https://priv-a/...,https://priv-b/...,https://public-alchemy-fallback/...
BROADCAST_RPCS=

# Optional multi-chain profiles for OpenSea drops. The bot reads the drop chain and
# automatically selects the matching profile before nonce/sign/broadcast.
# Add only the chains you actually use. RPCs in each profile are fanned out in parallel.
RPC_URL_ETHEREUM=
BROADCAST_RPCS_ETHEREUM=
CHAIN_ID_ETHEREUM=1
RPC_URL_BASE=
BROADCAST_RPCS_BASE=
CHAIN_ID_BASE=8453
RPC_URL_ARBITRUM=
BROADCAST_RPCS_ARBITRUM=
CHAIN_ID_ARBITRUM=42161
RPC_URL_OPTIMISM=
BROADCAST_RPCS_OPTIMISM=
CHAIN_ID_OPTIMISM=10
RPC_URL_POLYGON=
BROADCAST_RPCS_POLYGON=
CHAIN_ID_POLYGON=137
RPC_URL_ROBINHOOD=
BROADCAST_RPCS_ROBINHOOD=
CHAIN_ID_ROBINHOOD=4663

# Before every live fire/api-snipe broadcast: parallel eth_blockNumber probe, reorder URLs fastest-first,
# then still fan-out in PARALLEL (never sequential). Default on. Set 0 to skip.
RPC_AUTO_RANK=1
# Samples per RPC for auto-rank latency probe (median). Default 3.
RPC_RANK_SAMPLES=3

# After broadcast, poll receipt up to N ms and print inclusion_ms. 0 = skip watch.
INCLUSION_WATCH_MS=0

CHAIN_ID=4663
SEADROP_ADDRESS=0x00005EA00Ac477B1030CE78506496e8C2DE24bf5
FEE_RECIPIENT=0x0000a26b00c1F0DF003000390027140000fAa719
GAS_LIMIT=300000
MAX_FEE_GWEI=5
PRIORITY_FEE_GWEI=1
RUST_LOG=info
RBF_AFTER_MS=4000
RBF_MAX=3

# REQUIRED for WL / signed / allowlist (api-arm, api-snipe). Main daily path.
OPENSEA_API_KEY=
# Hammer (WL FCFS). Aggressive defaults — raise backoff if you 429.
OPENSEA_HAMMER_TIMEOUT_MS=60000
OPENSEA_HAMMER_BACKOFF_MS=15
OPENSEA_HAMMER_PARALLEL=2
# Start WL hammer this many ms BEFORE the fire window (early_ms). Default 3000.
OPENSEA_HAMMER_LEAD_MS=3000

# Telegram control (subcommand: telegram). Never commit real values.
TELEGRAM_BOT_TOKEN=
# Required: unlock with /password <code>. Never commit the real value.
TELEGRAM_BOT_PASSWORD=
# Optional allowlist: if set, chat must match AND unlock with password.
TELEGRAM_CHAT_ID=

